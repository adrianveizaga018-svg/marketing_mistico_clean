# Sin listado de carpetas
Options -Indexes

# Bloquea archivos que nunca deben verse desde el navegador (copias, configuraciones, SQL, logs, ocultos)
<FilesMatch "(?i)(^\.|\.(sql|sqlite|db|bak|old|orig|swp|log|ini|env|sh|md|lock|yml|yaml|dist)$|^(composer\.(json|lock)|package(-lock)?\.json|mm_config\.php|test_db\.php)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # HTTPS: actívalo en hPanel → Seguridad → SSL → "Forzar HTTPS" (evita bucles de redirección aquí).
  # La API nunca cae en React: si el archivo no existe devuelve 404 real
  RewriteRule ^(api|_mm)/ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/xhtml+xml application/rss+xml
</IfModule>

# Browser Caching with Cache-Control
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Videos - 1 year
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # CSS and JavaScript - 1 year (they have hashes in filenames from webpack)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Fonts - 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # HTML - short cache (1 hour)
  ExpiresByType text/html "access plus 1 hour"

  # JSON - short cache (1 hour)
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Cámara solo para el escáner QR de la puerta; nada de micrófono ni ubicación.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header unset X-Powered-By
</IfModule>

# Add immutable flag for hashed assets
<IfModule mod_headers.c>
  # For JS/CSS with hashes (webpack builds with contenthash)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # For images and fonts
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # For HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

